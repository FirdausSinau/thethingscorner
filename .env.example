APP_NAME="Thethingscorner"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL lokal
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_thethingscorner
DB_USERNAME=postgres
DB_PASSWORD=

# Neon bersama: isi DB_URL, lalu hapus/comment DB_HOST sampai DB_PASSWORD.
# DB_URL="postgresql://user:password@host/database?sslmode=require"
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Lokal: local + public
# Kerja bersama Neon: neon + neon
FILESYSTEM_DISK=local
PRODUCT_IMAGES_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Neon Object Storage (dipakai kalau FILESYSTEM_DISK=neon)
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=ap-southeast-1
NEON_STORAGE_BUCKET=product
NEON_STORAGE_ENDPOINT=

# Kompatibilitas konfigurasi AWS/S3 lama
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ENDPOINT=
AWS_BUCKET=product
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

PAYMENT_DRIVER=fake
# Detik. Sementara QRIS 30 detik untuk pengujian. Produksi: 1800 (30 menit).
QRIS_RESERVATION_SECONDS=30
VA_RESERVATION_SECONDS=1800
EWALLET_RESERVATION_SECONDS=1800
MANUAL_TRANSFER_RESERVATION_SECONDS=3600
SHIPPING_DRIVER=fake
WHATSAPP_ADMIN_NUMBER=
APP_TIMEZONE=Asia/Jakarta
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
BITESHIP_API_KEY=
BITESHIP_ORIGIN_AREA_ID=


